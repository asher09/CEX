generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  orders   Order[]
}

model Stock {
  id     Int     @id @default(autoincrement())
  title  String
  symbol String  @unique
  orders Order[]
  fills  Fill[]
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  stockId   Int
  side      String   // "BUY" | "SELL"
  type      String   // "LIMIT" | "MARKET"
  price     Float?
  qty       Float
  filledQty Float    @default(0)
  status    String   // "OPEN" | "FILLED" | "CANCELLED"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  stock Stock @relation(fields: [stockId], references: [id])
  buyFills Fill[] @relation("BuyOrderFills")
  sellFills Fill[] @relation("SellOrderFills")
}

model Fill {
  id          Int      @id @default(autoincrement())
  stockId     Int
  price       Float
  qty         Float
  buyOrderId  Int
  sellOrderId Int
  createdAt   DateTime @default(now())

  stock Stock @relation(fields: [stockId], references: [id])
  buyOrder Order @relation("BuyOrderFills", fields: [buyOrderId], references: [id])
  sellOrder Order @relation("SellOrderFills", fields: [sellOrderId], references: [id])
}